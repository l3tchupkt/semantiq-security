              "name": "Sensitive Data Exposure in addcrypted",
              "shortDescription": {
                "text": "Sensitive Data Exposure in addcrypted"
              },
              "fullDescription": {
                "text": "Endpoint or helper 'addcrypted' serializes sensitive authentication credentials into response or logs."
              },
              "defaultConfiguration": {
