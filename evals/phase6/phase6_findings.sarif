                        "physicalLocation": {
                          "artifactLocation": {
                            "uri": "",
                            "uriBaseId": "%SRCROOT%"
                          },
                          "region": {
                            "startLine": 122,
                            "endLine": 139,
                            "snippet": {
                              "text": "def find_worktree_git_dir(dotgit: PathLike) -> Optional[str]:\n    \"\"\"Search for a gitdir for this worktree.\"\"\"\n    try:\n        statbuf = os.stat(dotgit)\n    except (FileNotFoundError, NotADirectoryError):\n        return None\n    if not stat.S_ISREG(statbuf.st_mode) or statbuf.st_size > (1 << 20):\n        return None\n\n    try:\n        with open(dotgit, \"rb\") as fp:\n            content_bytes = fp.read(statbuf.st_size)\n        if len(content_bytes) != statbuf.st_size:\n            return None\n        content = os.fsdecode(content_bytes).rstrip(\"\\r\\n\")\n    except (OSError, UnicodeError):\n        return None\n    return content[8:] if len(content) >= 9 and content.startswith(\"gitdir: \") else None"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ],
