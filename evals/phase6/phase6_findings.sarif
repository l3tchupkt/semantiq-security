                              "text": "class FourSharedCom(BaseAccount):\n    __name__ = \"FourSharedCom\"\n    __type__ = \"account\"\n    __version__ = \"0.14\"\n    __status__ = \"testing\"\n\n    __description__ = \"\"\"FourShared.com account plugin\"\"\"\n    __license__ = \"GPLv3\"\n    __authors__ = [\n        (\"zoidberg\", \"zoidberg@mujmail.cz\"),\n        (\"stickell\", \"l.stickell@yahoo.it\"),\n    ]\n\n    def grab_info(self, user, password, data):\n        #: Free mode only for now\n        return {\"premium\": False}\n\n    def signin(self, user, password, data):\n        self.req.cj.set_cookie(\"4shared.com\", \"4langcookie\", \"en\")\n\n        res = self.load(\n            \"https://www.4shared.com/web/login\",\n            post={\n                \"login\": user,\n                \"password\": password,\n                \"remember\": \"on\",\n                \"_remember\": \"on\",\n                \"returnTo\": \"http://www.4shared.com/account/home.jsp\",\n            },\n        )\n\n        if \"Please log in to access your 4shared account\" in res:\n            self.fail_login()"
