              "name": "Use of Weak Cryptographic Hash Function (hashlib.md5)",
              "shortDescription": {
                "text": "Use of Weak Cryptographic Hash Function (hashlib.md5)"
              },
              "fullDescription": {
                "text": "hashlib.md5 is cryptographically broken and vulnerable to collision attacks."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "help": {
                "text": "Upgrade to secure hashing algorithms such as SHA-256 (hashlib.sha256) or SHA-3."
