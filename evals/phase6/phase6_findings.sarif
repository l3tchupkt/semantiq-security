                "precision": "high"
              }
            },
            {
              "id": "SQ-PY-004",
              "name": "Potential SSRF via dynamic HTTP request in urllib.request.urlopen",
              "shortDescription": {
                "text": "Potential SSRF via dynamic HTTP request in urllib.request.urlopen"
              },
              "fullDescription": {
                "text": "Outbound HTTP request to dynamic URL without explicit destination validation."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "help": {
                "text": "Validate destination URLs against an allowlist of trusted domains and restrict access to private IP ranges."
              },
              "properties": {
