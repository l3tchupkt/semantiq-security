              "shortDescription": {
                "text": "Missing Authorization on Sensitive Route: /script/abort"
              },
              "fullDescription": {
                "text": "Sensitive endpoint '/script/abort' is accessible without authentication decorators while peer endpoints enforce access controls."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "help": {
                "text": "Apply appropriate authentication and role-based access control decorators (@login_required, @roles_required) to the route handler."
